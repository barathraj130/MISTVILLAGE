 "say": {
  "open":  {"en": ["Opening up, thambi. Give me ten minutes.", "Shutter's stuck again. Every morning."], "ta": ["இப்போதான் திறக்கிறேன் தம்பி. பத்து நிமிஷம்.", "ஷட்டர் தினமும் இப்படித்தான் மாட்டுது."]},
  "close": {"en": ["We're closing, thambi. Come tomorrow.", "Long day. Going home."], "ta": ["மூடுறோம் தம்பி. நாளைக்கு வாங்க.", "நீண்ட நாள். வீட்டுக்குப் போறேன்."]},
  "work":  {"en": ["Busy now, thambi. Later?", "Yes? Quickly, the lunch rush is coming."], "ta": ["இப்போ பிஸி தம்பி. அப்புறம்?", "சொல்லுங்க, சீக்கிரம், மதிய கூட்டம் வருது."]},
  "guard": {"en": ["Who are you looking for?", "Nobody goes up without signing the register."], "ta": ["யாரைத் தேடுறீங்க?", "ரிஜிஸ்டர்ல கையெழுத்து போடாம யாரும் மேலே போகக்கூடாது."]},
  "eat":   {"en": ["Eating, thambi. Sit, have something.", "Mm. The sambar is good today."], "ta": ["சாப்பிடுறேன் தம்பி. உக்காருங்க, ஏதாவது சாப்பிடுங்க.", "ம்ம். இன்னிக்கு சாம்பார் நல்லா இருக்கு."]},
  "wait":  {"en": ["Waiting for the bus. Late again.", "Where to? Auto?"], "ta": ["பஸ்ஸுக்கு காத்திருக்கேன். இன்னிக்கும் லேட்.", "எங்கே போகணும்? ஆட்டோவா?"]},
  "chat":  {"en": ["Did you see the paper? That murder at Pudhur Vayal.", "Vanakkam. Hot today."], "ta": ["பேப்பர் பார்த்தீங்களா? புதூர் வயல் கொலை.", "வணக்கம். இன்னிக்கு வெயில் அதிகம்."]},
  "shop":  {"en": ["Vegetables are so dear this week.", "Just a few things for the house."], "ta": ["இந்த வாரம் காய்கறி விலை அதிகம்.", "வீட்டுக்கு கொஞ்சம் சாமான்."]},
