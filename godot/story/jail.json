   "lines": [
    {
     "who": "rasu",
     "en": "New? You sweep like a man who has never swept. Sit. The warder doesn't look at this tree.",
     "ta": "புதுசா? இதுவரைக்கும் பெருக்காத ஆள் மாதிரி பெருக்கற. உக்காரு. வார்டர் இந்த மரத்த பாக்க மாட்டாரு."
    },
    {
     "who": "karthik",
     "en": "They say I killed a man. I drove his car. That's all I did.",
     "ta": "நான் ஒருத்தர கொன்னேன்னு சொல்றாங்க. அவர் கார ஓட்டினேன். அவ்வளவு தான்."
    },
    {
     "who": "rasu",
     "en": "Everyone here only drove the car. ...What did they catch you with?",
     "ta": "இங்க எல்லாரும் கார மட்டும் தான் ஓட்டினாங்க. ...எதை வச்சு புடிச்சாங்க?"
    },
    {
     "who": "karthik",
     "en": "A card. Someone opened our office at night with card number seven.",
     "ta": "ஒரு கார்டு. ராத்திரி யாரோ ஏழாம் நம்பர் கார்டுல எங்க ஆஃபீஸ திறந்திருக்காங்க."
    },
    {
     "who": "rasu",
     "en": "I fitted those locks for twenty years before this. In a firm, the small numbers go to the people who own it. One, two... the partners. The office boys get the big ones.",
     "ta": "இதுக்கு முன்னாடி இருபது வருஷம் அந்த பூட்டு தான் போட்டேன். ஒரு கம்பெனில சின்ன நம்பர் எல்லாம் முதலாளிங்களுக்கு. ஒண்ணு, ரெண்டு... பார்ட்னர்ங்க. ஆஃபீஸ் பையன்களுக்கு பெரிய நம்பர்."
    },
    {
     "who": "karthik",
     "en": "(Seven. Not an office boy's number.)",
     "ta": "(ஏழு. ஆஃபீஸ் பையன் நம்பர் இல்ல.)"
    }
