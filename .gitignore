# Godot cache / imports (rebuilt on open)
godot/.godot/
*.import.tmp
# Blender backups
*.blend1
*.blend2
# raw downloads (OSM, SRTM, Poly Haven sources): re-fetched by the tools
mapdata/
# OS / editor
.DS_Store
__pycache__/
*.pyc

# generated full-map Blender file (tools/build_map_blend.py), too big for GitHub
blender/
.venv/
build/
vendor/
godot/assets/city/

# build logs (tools' runs)
build_*.log
previews/**/*.log
# city props: the textures Godot extracts from each .glb on import (the .glb carries them; re-extracted on any
# import) and market_props.py's generated texture folder (re-made each build). Already-tracked images stay tracked;
# a new hand-made image here needs `git add -f`.
godot/assets/city_props/*.png
godot/assets/city_props/*.jpg
godot/assets/city_props/tex/

# trailer footage and renders (the edits in trailer/*.json are kept)
trailer/clips/
trailer/out/
trailer/*.wav
trailer/*.skill
trailer/*.log
trailer/clips/
trailer/gameplay/out/
trailer/gameplay/vo/
trailer/gameplay/*.log
trailer/posts/raw/
trailer/posts/out/
trailer/posts/*.zip
