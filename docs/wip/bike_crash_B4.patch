+## Over it goes: the balance let go, the engine and brakes released, a little roll to start it toward the side it
+## leans (or the side the hit came from); the rider thrown (`fell_over`, city_test.gd).
+func fall_over(push: Vector3) -> void:
+	if fallen or not two_wheeler:
+		return
+	fallen = true
+	autopilot = true                                     # (nobody's riding it: no keys move it)
+	in_throttle = 0.0
+	in_brake = 0.0
+	in_steer = 0.0
+	_thr = 0.0
+	engine_force = 0.0
+	brake = 0.0
+	var side := signf(-lean) if absf(lean) > 0.05 else (1.0 if randf() < 0.5 else -1.0)
+	apply_torque_impulse(forward() * side * -mass * 0.6)
+	print("BIKE down: lean %.0f°, %.1f m/s" % [rad_to_deg(lean), linear_velocity.length()])
+	fell_over.emit(push)
+
+
+## Lifted upright again (city_test.gd: he's beside it, F): its own heading kept, back on its wheels.
+func lift_up() -> void:
+	if not fallen:
+		return
+	var fw := forward()
+	fw.y = 0.0
+	fw = fw.normalized() if fw.length() > 0.1 else Vector3.FORWARD
+	var at := global_position
+	var from_basis := global_basis
+	var to_basis := Basis.looking_at(-fw * FWD, Vector3.UP)
+	freeze = true
+	var t := 0.0
+	while t < 1.2:                                       # (raised over a second and more, as a man lifts it)
+		t += get_physics_process_delta_time()
+		var k := smoothstep(0.0, 1.0, t / 1.2)
+		global_transform = Transform3D(from_basis.slerp(to_basis, k), at + Vector3.UP * 0.15 * sin(k * PI))
+		await get_tree().physics_frame
+	linear_velocity = Vector3.ZERO
+	angular_velocity = Vector3.ZERO
+	lean_target = 0.0
+	fallen = false
+	autopilot = false
+	freeze = false
+
